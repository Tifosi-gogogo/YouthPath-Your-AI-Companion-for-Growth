QWidget { color: #293c35; font-size: 14px; }
QMainWindow, #messages, QScrollArea { background: #f7f9f8; }
#header, #footer { background: #ffffff; }
#header { border-bottom: 1px solid #dfe7e3; }
#footer { border-top: 1px solid #dfe7e3; }
#appTitle { font-size: 24px; font-weight: 700; color: #185c49; }
#modeLabel { color: #8c5719; background: #fff3d6; padding: 6px 10px; border-radius: 4px; }
#sidebar { background: #eef5ef; border-right: 1px solid #dfe7e3; }
#avatar { background: #d2e8dd; color: #185c49; border-radius: 32px; font-size: 26px; font-weight: 700; }
#characterName { font-size: 25px; font-weight: 600; color: #23533f; }
#tagline { color: #476a5c; }
#muted, #sectionLabel { color: #6b7872; font-size: 12px; }
#conversationTitle { font-size: 23px; font-weight: 600; color: #234c3d; }
#caseTitle { color: #7a8d80; font-size: 12px; padding-bottom: 4px; }
#welcome { background: #edf4ef; color: #486454; padding: 16px; border-radius: 12px; }
#userBubble { background: #e0f0e8; border: 1px solid #cce3d7; border-radius: 8px; }
#aiBubble { background: #ffffff; border: 1px solid #dae7dd; border-radius: 12px; }
#messageRow { background: transparent; }
#bubbleTitle { font-weight: 600; color: #365c4b; font-size: 12px; }
#emotionTags { color: #476a5c; }
#emotionTag { color: #416f55; background: #eaf4ed; border-radius: 10px; padding: 3px 10px; font-size: 12px; }
#suggestion { background: #f2f7f1; color: #41624c; border-radius: 6px; padding: 9px 12px; }
#safetyCard { background: #fff2e6; color: #774d31; padding: 12px; border: 1px solid #efcfad; border-radius: 8px; }
#suggestionTitle { font-weight: 600; font-size: 12px; color: #476a5c; }
QLineEdit, QSpinBox { padding: 6px; border: 1px solid #cddbd3; border-radius: 4px; background: #ffffff; }
QPushButton { background: #ffffff; border: 1px solid #ccd8d1; border-radius: 6px; padding: 8px 14px; }
QPushButton:hover { background: #e5eee9; border-color: #90b7a3; }
QPushButton:pressed { background: #d8e7de; }
QPushButton:disabled { color: #8b9892; background: #edf0ee; border-color: #dde3df; }
#sceneButton { background: transparent; border: none; text-align: left; padding: 9px 8px; }
#sceneButton:hover { background: #dceae2; }
#sceneButton:checked { color: #216649; background: #deece0; font-weight: 600; border-left: 3px solid #73a286; }
#primaryButton { background: #23795c; border: none; color: #ffffff; font-weight: 600; }
#primaryButton:hover { background: #1b654c; }
#primaryButton:disabled { background: #9ab8aa; color: #f4f8f6; }
QPlainTextEdit { background: #ffffff; border: 1px solid #cddbd3; border-radius: 6px; padding: 10px; selection-background-color: #b8dfcb; }
QPlainTextEdit:focus { border: 1px solid #23795c; }
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar::handle:vertical { background: #c3d3c9; min-height: 24px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
